# Copy this file to .env and fill in your values
# cp .env.example .env

# PostgreSQL
DB_NAME=dementianext_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Optional: Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq API Key (free tier available) - get from https://console.groq.com/keys
GROQ_API_KEY=
COMPANION_LLM_MODEL=llama-3.3-70b-versatile
