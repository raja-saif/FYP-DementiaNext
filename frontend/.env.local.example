# Copy this file to .env.local and fill in your values
# cp .env.local.example .env.local

# Django origin only — no trailing slash, no /api suffix
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Vercel / production: set this in Project → Settings → Environment Variables
# to your public API, e.g. https://your-space.hf.space (then redeploy).
# Alternative legacy name (full URL including /api) also works:
# NEXT_PUBLIC_API_URL=https://your-space.hf.space/api

# Optional: Google OAuth (same client ID as backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
